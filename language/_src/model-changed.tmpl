
      <section class="md-section" aria-labelledby="changed-title">
        <div class="container">
          <h2 id="changed-title">What changed since {{prev}}</h2>
          <p class="md-sub">{{sub}}</p>
          <div class="md-change">
            <div class="md-change-card">
{{rows}}
              {{notes}}
            </div>
            <div class="md-change-card md-versions">
              <b>{{lang}} answer score by version</b>
              <div class="md-bars">{{bars}}</div>
              <p class="md-bars-note">{{caption}}</p>
            </div>
          </div>
        </div>
      </section>
